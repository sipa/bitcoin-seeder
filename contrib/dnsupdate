#!/bin/bash
# Copy bitcoin-seeder's A/AAAA answers into a local BIND zone.
set -euo pipefail

usage() {
  echo "Usage: $0 -h zone [-a seeder-address] [-p seeder-port] [-w 'x1 x5 ...'] [-k key-file]" >&2
  exit 1
}

ZONE=
SEEDER_ADDRESS=127.0.0.1
SEEDER_PORT=15353
# Match the default filter whitelist in main.cpp; override for custom seeds.
FILTERS='x1 x5 x9 xd x49 x400 x404 x408 x40c x448 x809 x849 xc08 xc48'
KEY_FILE=
while getopts ':h:a:p:w:k:' option; do
  case "$option" in
    h) ZONE=${OPTARG%.} ;;
    a) SEEDER_ADDRESS=$OPTARG ;;
    p) SEEDER_PORT=$OPTARG ;;
    w) FILTERS=$OPTARG ;;
    k) KEY_FILE=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[[ $# == 0 && ${#ZONE} -le 253 && $ZONE =~ ^([[:alnum:]]([[:alnum:]-]*[[:alnum:]])?\.)+[[:alnum:]]([[:alnum:]-]*[[:alnum:]])?$ ]] || usage
[[ $SEEDER_PORT =~ ^[0-9]{1,5}$ ]] || usage
(( 10#$SEEDER_PORT >= 1 && 10#$SEEDER_PORT <= 65535 )) || usage
read -r -a filters <<< "$FILTERS"
names=("$ZONE")
for filter in "${filters[@]}"; do
  [[ $filter =~ ^x[1-9a-fA-F][0-9a-fA-F]{0,15}$ ]] || usage
  names+=("$filter.$ZONE")
done

umask 077
updates=$(mktemp)
trap 'rm -f "$updates"' EXIT
nsupdate_args=(-l -v)
if [[ -n $KEY_FILE ]]; then
  # An explicit TSIG key can be used by a dedicated, non-root updater.
  nsupdate_args=(-k "$KEY_FILE" -v)
  printf 'server 127.0.0.1\n' > "$updates"
fi
printf 'zone %s.\n' "$ZONE" >> "$updates"

# Fetch everything before submitting a single update. A timeout or SERVFAIL
# must not delete the previously published seed records.
for name in "${names[@]}"; do
  for type in A AAAA; do
    if ! answer=$(dig -r +noall +comments +answer +time=5 +tries=1 \
      -t "$type" -p "$SEEDER_PORT" "@$SEEDER_ADDRESS" "$name.") || \
      [[ $answer != *'status: NOERROR,'* ]]; then
      printf 'DNS query failed for %s %s; zone left unchanged\n' "$name" "$type" >&2
      exit 1
    fi
    printf 'update delete %s. %s\n' "$name" "$type" >> "$updates"
    # Keep only address records for this owner, not comments or other RR types.
    awk -v name="$name." -v type="$type" \
      'tolower($1) == tolower(name) && $3 == "IN" && $4 == type {
        print "update add " name " 3600 " type " " $5
      }' <<< "$answer" >> "$updates"
  done
done
printf 'send\n' >> "$updates"
nsupdate "${nsupdate_args[@]}" "$updates"
